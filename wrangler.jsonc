{
  // Sito di Panero Garden Center: file statici in public/ più un piccolo Worker (src/index.js)
  // che fornisce le previsioni meteo su /api/meteo.
  "name": "panerogardencenter",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
