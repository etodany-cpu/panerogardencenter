{
  // Sito di Panero Garden Center: file statici in public/ più un piccolo Worker (src/index.js)
  // che fornisce le previsioni meteo su /api/meteo.
  "name": "panerogardencenter",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*", "/google96a36c1ad8593c7b.html", "/robot-rasaerba-kress", "/robot-rasaerba-honda-miimo", "/assistenza-robot-rasaerba", "/attrezzi-giardino-honda", "/attrezzi-batteria-kress", "/rasaerba-grin"],
    "not_found_handling": "single-page-application"
  },
  // Statistiche anonime delle visite (vedi /api/hit e /statistiche.html).
  "d1_databases": [
    { "binding": "STATS", "database_name": "panerogarden-stats", "database_id": "535cf08a-1c1f-4e18-b80f-8e5b4ba8d3f6" }
  ],
  "vars": {
    // Hash SHA-256 della password della pagina statistiche (la password non è nel codice).
    "STATS_HASH": "80b4f637db22803067230366ae083f4d96cdbc197e56ce3732f993bdf7e1481a"
  }
}
